/*
 * Lily58 Pro — alec's keymap (stock layout + tweaks)
 *
 *   0 default
 *   1 lower   (hold left inner thumb;  quick TAP = ENTER)
 *   2 raise   (hold right inner thumb; quick TAP = SPACE)
 *   3 super   (hold lower + raise together)  -> media / brightness / volume
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        super {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        // Thumb layer-tap: HOLD = the layer, TAP = a second helping of the two
        // keys the thumbs use most, so either inner thumb can produce them.
        //   LOWER tap -> ENTER
        //   RAISE tap -> SPACE
        // hold-preferred: any other key pressed while the thumb is down resolves
        //   to HOLD instantly, so normal layer use never misfires a tap.
        // require-prior-idle-ms: pressed mid-typing-burst -> forced HOLD, so fast
        //   rolls don't emit a stray space/enter. Both thumbs held still ->
        //   conditional Super layer.
        lt_thumb: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
// | CTRL  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | ALT  | GUI  | LOWER|  BSPC  |  | SPACE | RAISE| ENTER |  Fn   |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                     &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp GRAVE
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                      &kp Y  &kp U    &kp I     &kp O   &kp P    &kp MINUS
&kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G                      &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &kp LBKT   &kp RBKT &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LALT &kp LGUI &lt_thumb 1 RET   &kp BSPC   &kp SPACE  &lt_thumb 2 SPACE  &kp RET  &kp GLOBE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
// BT profiles / F-keys / symbols.  Z & B = Page Down, X/C/V = Vol-/Play/Vol+, [ = Home.
            bindings = <
&bt BT_CLR &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3 &bt BT_SEL 4                 &trans    &trans    &trans    &trans    &trans    &trans
&kp F1     &kp F2           &kp F3            &kp F4            &kp F5       &kp F6                       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&kp GRAVE  &kp EXCL         &kp AT            &kp HASH          &kp DOLLAR   &kp PRCNT                    &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp TILDE
&trans     &kp PG_DN        &kp C_VOL_DN      &kp C_PP          &kp C_VOL_UP &kp PG_DN &kp HOME &trans    &trans    &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE
                                              &trans            &trans       &trans    &trans   &trans    &trans    &trans    &trans
            >;
        };

        raise_layer {
// Numbers / arrows.  Left A/S/D/F = Opt+4/3/2/1, Z/X/C/V = Opt+7/8/9/0 (AeroSpace workspaces).  H J K L = vim arrows.
            bindings = <
&trans    &trans &trans &trans  &trans  &trans                       &trans    &trans   &kp HOME  &kp END  &trans    &trans
&kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                       &kp N6    &kp N7   &kp N8    &kp N9   &kp N0    &trans
&trans    &kp LA(N4) &kp LA(N3) &kp LA(N2) &kp LA(N1) &trans           &kp LEFT  &kp DOWN &kp UP    &kp RIGHT &kp PG_DN &kp PG_UP
&trans    &kp LA(N7) &kp LA(N8) &kp LA(N9) &kp LA(N0) &trans   &trans   &trans    &kp KP_PLUS &kp MINUS &kp EQUAL &kp LBKT &kp RBKT  &kp BSLH
                        &trans  &trans  &trans    &trans   &trans    &trans    &trans   &trans
            >;
        };

        super_layer {
// Hold LOWER + RAISE.  Right hand (home-row aligned): brightness / transport / volume.
            bindings = <
&trans &trans &trans &trans &trans &trans                        &trans       &trans       &trans       &trans &trans &trans
&trans &trans &trans &trans &trans &trans                        &trans &kp C_BRI_DN &kp C_BRI_UP &trans     &trans &trans
&trans &trans &trans &trans &trans &trans                        &trans &kp C_PREV   &kp C_PP     &kp C_NEXT &trans &trans
&trans &trans &trans &trans &trans &trans &trans        &trans   &trans &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &trans &trans
                            &trans &trans &trans &trans  &trans   &trans       &trans       &trans
            >;
        };
    };
};
